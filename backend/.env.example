APP_NAME=TradeMind API
APP_ENV=development
APP_VERSION=0.1.0
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BINANCE_BASE_URL=https://api.binance.com
TWELVEDATA_API_KEY=
WHALE_ALERT_API_KEY=
GEMINI_API_KEY=
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
NEWS_USE_GEMINI_SENTIMENT=true
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
REDIS_URL=
SENTRY_DSN=

# Phase 4 in-process prediction serving
ML_MODEL_BUNDLE_PATH=models/current/model_bundle.json
ML_SERVING_HORIZON_BARS=4
ML_SERVING_REQUIRE_AUDIT=true

# Prediction route security. Provision the same random value only to the internal
# server-side caller and the FastAPI runtime; never place it in Flutter or source control.
PREDICTION_SERVICE_TOKEN=
PREDICTION_RATE_LIMIT_WINDOW_SECONDS=60
PREDICTION_RATE_LIMIT_MAX_REQUESTS=120
PREDICTION_MAX_BODY_BYTES=65536
PREDICTION_TIMEOUT_SECONDS=8
# These origins are used only when APP_ENV is development/local/test; production has none.
CORS_LOCAL_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# GitHub Actions must store SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY as repository secrets.
# The service-role key is server-only; never expose it to the mobile/web client.

# Provisional assumptions carried from Phases 1–3; confirm before production use.
TRADING_CANDLE_INTERVAL=15m
TRADING_MARKET_MODE=spot
ML_ENTRY_ATR_MULTIPLE=1.25
ML_ROUND_TRIP_COST_FLOOR=0.003
ML_LABEL_HORIZONS_BARS=4,8,16
